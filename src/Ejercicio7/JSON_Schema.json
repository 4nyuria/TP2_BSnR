//colección pedidos
{
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Pedido",
      "type": "object",
      "required": [
        "_id",
        "usuarioId",
        "fecha",
        "estado",
        "items",
        "direccionEnvio",
        "total"
      ],
      "properties": {
        "_id": {
          "type": "string"
        },
        "usuarioId": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date"
        },
        "estado": {
          "type": "string",
          "enum": [
            "pendiente",
            "pagado",
            "enviado",
            "entregado",
            "cancelado"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "productoId",
              "nombreProducto",
              "cantidad",
              "precioUnitario",
              "subtotal"
            ],
            "properties": {
              "productoId": {
                "type": "string"
              },
              "nombreProducto": {
                "type": "string"
              },
              "cantidad": {
                "type": "number",
                "minimum": 0
              },
              "precioUnitario": {
                "type": "number",
                "minimum": 0
              },
              "subtotal": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "direccionEnvio": {
          "type": "object",
          "required": [
            "calle",
            "numero",
            "ciudad",
            "provincia",
            "codigoPostal"
          ],
          "properties": {
            "calle": {
              "type": "string"
            },
            "numero": {
              "type": "number",
              "minimum": 0
            },
            "ciudad": {
              "type": "string"
            },
            "provincia": {
              "type": "string"
            },
            "codigoPostal": {
              "type": "string"
            }
          }
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    }

